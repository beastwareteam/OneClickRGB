*.out
*.app

# debug information files
*.dwo

# Build output
build/
!build/.gitkeep
production/build/
build_app/
build_tests/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
*.lib
*.exe
!portable/*.exe

# Release archives and the staged portable package - build artifacts, published
# via GitHub Releases rather than committed (see .github/workflows/release.yml).
*.zip
OneClickRGB_*_Portable/

# Bundled CMake copy: a downloaded toolchain, not source. build_app.bat uses it
# when present and falls back to cmake on PATH otherwise. Only the toolchain is
# ignored - tools/ itself holds scripts that belong in the repository.
tools/cmake/

# Claude Code workspace settings
.claude/

# IDE
.vs/
.vscode/
*.vcxproj*
*.sln

# Debug/temp files
*.log
*.txt
!README.txt
# The blanket *.txt rule above would otherwise swallow the build files.
!CMakeLists.txt
!**/CMakeLists.txt
*.res

# Generated resources
resources/*_rc.py

# OS files
Thumbs.db
.DS_Store

# Experimental/debug code (not for production)
src/experimental/

# Old planning documents (archived)
docs/planning/

# Legacy builds
legacy/

# Root-level duplicate DLLs (originals are in dependencies/hidapi/ and dependencies/PawnIO/)
dependencies/hidapi.dll
dependencies/PawnIOLib.dll
