// OneClickRGB Resource File
#include <windows.h>

// Icon - ID 1 wird automatisch als App-Icon verwendet
// IDI_ICON1 = 101
101 ICON "OneClickRGB.ico"

// Application manifest. Ohne diesen Eintrag landet OneClickRGB.manifest nicht
// im EXE: der Linker wird nicht mit /MANIFESTINPUT aufgerufen, also fehlt das
// angeforderte requireAdministrator. Die App startet dann unprivilegiert und
// die G.Skill-RAM-Steuerung (SMBus ueber PawnIO) scheitert stillschweigend -
// der RAM bleibt dunkel, waehrend alle anderen Geraete leuchten.
// 1 = CREATEPROCESS_MANIFEST_RESOURCE_ID (fuer eine EXE).
1 RT_MANIFEST "OneClickRGB.manifest"

// Version Info
VS_VERSION_INFO VERSIONINFO
FILEVERSION 2,0,0,1
PRODUCTVERSION 2,0,0,1
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "BeastWareTeam"
            VALUE "FileDescription", "RGB Control Application"
            VALUE "FileVersion", "2.0.0.1"
            VALUE "InternalName", "OneClickRGB"
            VALUE "LegalCopyright", "Copyright (C) 2026 BeastWareTeam"
            VALUE "OriginalFilename", "OneClickRGB.exe"
            VALUE "ProductName", "OneClickRGB"
            VALUE "ProductVersion", "2.0.0.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
