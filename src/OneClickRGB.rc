// OneClickRGB Resource File
#include <windows.h>

// Icon - ID 1 wird automatisch als App-Icon verwendet
// IDI_ICON1 = 101
// OneClickRGB.ico wird aus src/bw.ico erzeugt und enthaelt 16/20/24/32/48/64/
// 128/256 px als quadratische PNG-Eintraege. Die Vorgaengerdatei war defekt:
// ihr Verzeichniseintrag meldete 130x155 und 107476 Byte Bilddaten, die Datei
// hatte aber nur 41450 Byte - LoadImage lieferte in jeder Groesse NULL, das
// Tray blieb ohne Symbol.
101 ICON "OneClickRGB.ico"

// Wasserzeichen fuer den Fensterhintergrund. Als RCDATA-PNG statt als ICON:
// so bleibt der Alphakanal unveraendert und die Groesse wird nicht von den
// Icon-Metriken des Systems bestimmt, sondern beim Zeichnen gewaehlt.
200 RCDATA "watermark.png"

// Application manifest. Ohne diesen Eintrag landet OneClickRGB.manifest nicht
// im EXE: der Linker wird nicht mit /MANIFESTINPUT aufgerufen, also fehlt das
// angeforderte requireAdministrator. Die App startet dann unprivilegiert und
// die G.Skill-RAM-Steuerung (SMBus ueber PawnIO) scheitert stillschweigend -
// der RAM bleibt dunkel, waehrend alle anderen Geraete leuchten.
// 1 = CREATEPROCESS_MANIFEST_RESOURCE_ID (fuer eine EXE).
1 RT_MANIFEST "OneClickRGB.manifest"

// Version Info
VS_VERSION_INFO VERSIONINFO
FILEVERSION 3,6,0,0
PRODUCTVERSION 3,6,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "BeastWareTeam"
            VALUE "FileDescription", "RGB Control Application"
            VALUE "FileVersion", "3.6.0.0"
            VALUE "InternalName", "OneClickRGB"
            VALUE "LegalCopyright", "Copyright (C) 2026 BeastWareTeam"
            VALUE "OriginalFilename", "OneClickRGB.exe"
            VALUE "ProductName", "OneClickRGB"
            VALUE "ProductVersion", "3.6.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
